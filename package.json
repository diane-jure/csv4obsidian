{
  "name": "csv4obsidian",
  "version": "0.2.1",
  "description": "A spreadsheet-style CSV/TSV editor for Obsidian",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "tsx --tsconfig tsconfig.test.json --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "tsx": "^4.7.0",
    "typescript": "5.4.5"
  }
}
